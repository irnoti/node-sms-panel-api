{
  "name": "@irnoti/sdk",
  "version": "1.1.0",
  "description": "Official Node.js / TypeScript SDK for the irnoti platform API (SMS, pattern, SOS, phonebook, services, verify, bots, VoIP, webhooks).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/sdk.test.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "irnoti",
    "sms",
    "sms-api",
    "sdk",
    "api-client",
    "otp",
    "iran",
    "typescript"
  ],
  "homepage": "https://github.com/irnoti/node-sms-panel-api#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "irnoti",
    "email": "support@irnoti.com",
    "url": "https://irnoti.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irnoti/node-sms-panel-api.git"
  },
  "bugs": {
    "url": "https://github.com/irnoti/node-sms-panel-api/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
