{
  "name": "@irnoti/sdk",
  "version": "1.0.0",
  "description": "Official Node.js / TypeScript SDK for the irnoti platform API (SMS, pattern, SOS, phonebook, services, verify, bots, VoIP, webhooks).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/sdk.test.js"
  },
  "keywords": ["irnoti", "sms", "sdk", "api-client"],
  "homepage": "https://irnoti.com/docs",
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
